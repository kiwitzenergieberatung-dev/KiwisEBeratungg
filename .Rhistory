.input-wrap input {
width: 100%;
padding: 14px;
border: 1px solid #d1d5db;
border-radius: 12px;
font-size: 1rem;
margin-bottom: 14px;
}
.actions {
display: flex;
gap: 12px;
flex-wrap: wrap;
margin-top: 24px;
}
button {
border: none;
border-radius: 12px;
padding: 14px 22px;
font-size: 1rem;
cursor: pointer;
}
.btn-primary {
background: #16a34a;
color: #fff;
}
.btn-primary:hover {
background: #15803d;
}
.btn-secondary {
background: #e5e7eb;
color: #111827;
}
.btn-secondary:hover {
background: #d1d5db;
}
.result {
display: none;
margin-top: 28px;
background: #f0fdf4;
border: 1px solid #bbf7d0;
border-radius: 16px;
padding: 22px;
}
.result h2 {
margin-top: 0;
color: #166534;
}
.summary-box,
.section-box {
background: #fff;
border: 1px solid #dcfce7;
border-radius: 12px;
padding: 18px;
margin-top: 16px;
line-height: 1.6;
}
.section-box h3 {
margin-top: 0;
margin-bottom: 10px;
color: #14532d;
}
.measure-list {
margin: 0;
padding-left: 20px;
}
.measure-list li {
margin-bottom: 10px;
}
.badge-row {
display: flex;
gap: 10px;
flex-wrap: wrap;
margin-top: 14px;
}
.badge {
background: #dcfce7;
color: #166534;
border-radius: 999px;
padding: 8px 12px;
font-size: 0.9rem;
font-weight: 700;
}
.cta {
text-align: center;
margin-top: 22px;
}
.cta a {
display: inline-block;
padding: 14px 20px;
border-radius: 12px;
background: #14532d;
color: #fff;
text-decoration: none;
}
.cta a:hover {
background: #166534;
}
.notice {
margin-top: 18px;
font-size: 0.9rem;
color: #6b7280;
}
.debug {
margin-top: 24px;
background: #111827;
color: #f9fafb;
border-radius: 12px;
padding: 16px;
font-size: 0.9rem;
overflow-x: auto;
display: none;
}
@media (max-width: 700px) {
.wrapper {
margin: 20px auto;
padding: 12px;
}
.card {
padding: 18px;
}
h1 {
font-size: 1.6rem;
}
.question-title {
font-size: 1.25rem;
}
}
</style>
</head>
<body>
<div class="wrapper">
<div class="card">
<h1>Energie-Check</h1>
<p class="subtitle">
Beantworten Sie Schritt für Schritt einige kurze Fragen und erhalten Sie eine erste
Einschätzung zu sinnvollen energetischen Maßnahmen für Ihr Gebäude.
</p>
<div class="progress-wrap">
<div class="progress-info">
<span id="progressText">Frage 1 von 17</span>
<span id="progressPercent">6 %</span>
</div>
<div class="progress-bar">
<div class="progress-fill" id="progressFill"></div>
</div>
</div>
<div id="questionContainer" class="question-box"></div>
<div class="actions">
<button class="btn-secondary" id="backBtn" onclick="goBack()">Zurück</button>

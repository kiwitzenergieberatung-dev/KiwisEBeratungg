#Tabelle einlesen
#####In read_excel Spalte Anpassen!!!!!!!
Tabellestart <- read_excel("C:\\Users\\andki\\Desktop\\RSkripte\\Eberatung.xlsx", na="NA", sheet = 1, range = "A1:J191") #ggfändern
# Nur Zeilen ohne Lat geokodieren
tabelle_mit_koordinaten <- Tabellestart %>% filter(!is.na(Lat))
tabelle_ohne_koordinaten <- Tabellestart %>% filter(is.na(Lat))
tabelle_ohne_koordinaten <- Tabellestart %>%
filter(is.na(Lat)) %>%
select(-Lat, -Long)
# Geokodieren nur wenn nötig
if (nrow(tabelle_ohne_koordinaten) > 0) {
geokodiert <- tabelle_ohne_koordinaten %>%
geocode(address = Adresse, method = "osm", lat = "Lat", long = "Long")  # <-- schreibt direkt in Spalten Lat & Long
# Kombinieren: alle Zeilen mit und ohne Koordinaten
Tabelle <- bind_rows(tabelle_mit_koordinaten, geokodiert)
}
# Zielpfad definieren
zielpfad <- "C:/Users/andki/Desktop/RSkripte/KoordinatenBeratung.xlsx"
# Tabelle speichern
write.xlsx(Tabelle, file = zielpfad)
# Pfad zum Bildordner  ## das skript zum komprimieren liegt im eberater ordner
bild_pfad <- "C:/Users/andki/Desktop/RSkripte/Haeuserkomprimiert"
# Standardbild vorladen (001.jpg)
standard_bild <- file.path(bild_pfad, "001.jpg")
standard_kodiert <- if (file.exists(standard_bild)) {
paste0("data:image/jpeg;base64,", base64encode(standard_bild))
} else {
stop("Standardbild '001.jpg' nicht gefunden!")
}
# Neue Spalte anlegen
Tabelle$Bild <- NA_character_
# Vektor für fehlende Bilder vorbereiten
fehlende_rnummern <- c()
# Schleife über jede Zeile
for (i in seq_len(nrow(Tabelle))) {
rnummer <- Tabelle$Rnummer[i]
dateien <- list.files(
bild_pfad,
pattern = paste0("^", rnummer, "\\.(jpg|jpeg|png)$"),
full.names = TRUE,
ignore.case = TRUE
)
if (length(dateien) > 0) {
bilddatei <- dateien[1]
kodiert <- base64encode(bilddatei)
endung <- tolower(tools::file_ext(bilddatei))
mime_type <- if (endung == "png") "image/png" else "image/jpeg"
Tabelle$Bild[i] <- paste0("data:", mime_type, ";base64,", kodiert)
} else {
Tabelle$Bild[i] <- standard_kodiert
fehlende_rnummern <- c(fehlende_rnummern, rnummer)
}
}
Fehlt <- data.frame(Rnummer = fehlende_rnummern)
#Koordinaten in numeric
Tabelle <- Tabelle %>%
mutate(Long = as.numeric(Long),
Lat = as.numeric(Lat))
###wenn kein Bild oder keine Koordinate Raus
Tabelle <- Tabelle %>%
filter(!is.na(Lat), !is.na(Bild))
Tabelle <- Tabelle %>%
rename(Bildspalte = Bild)
# Konvertieren der Daten in ein sf-Objekt und benenne es ObjekteE statt Tabelle
ObjekteE <- st_as_sf(Tabelle, coords = c("Long", "Lat"), crs = 4326)
# Überprüfen Sie das sf-Objekt
print(ObjekteE)
###### ENDE BILDER EINLESEN UND TABELLE EINLESEN
#####vorbereiten layer
# Split the data into a list of dataframes based on unique values in the "Auto" column
split_Spalte <- split(ObjekteE, ObjekteE$`WelcheArt`) ##hier filtern nach attributen in spalte
# Check the split data
for (uniqueSpaltenwert in names(split_Spalte)) {
assign(uniqueSpaltenwert, split_Spalte[[uniqueSpaltenwert]])
}
###ende vorbereiten layer

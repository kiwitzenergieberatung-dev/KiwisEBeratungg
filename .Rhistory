# Ordnerpfad
ordner <- "C:/Users/andki/Desktop/RSkripte/Haeuser"
# Alle JPG-Dateien im Ordner
bilder <- list.files(
ordner,
pattern = "\\.(jpg|jpeg|png)$",
full.names = TRUE,
ignore.case = TRUE
)
# Zielordner (optional: separater Ordner für komprimierte Bilder)
zielordner  <- "C:/Users/andki/Desktop/RSkripte/Haeuserkomprimiert"
if (!dir.exists(zielordner)) dir.create(zielordner)
# Schleife zum Komprimieren
for (bildpfad in bilder) {
# Bildname extrahieren
name <- basename(bildpfad)
# Bild laden und komprimieren
bild <- image_read(bildpfad)
bild <- image_scale(bild, "800")  # z.B. auf 800 Pixel Breite skalieren
bild <- image_write(bild, path = file.path(zielordner, name), format = "jpeg", quality = 60)
}
